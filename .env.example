# Database — PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/spending_dashboard"

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# NextAuth base URL (required in production)
NEXTAUTH_URL="http://localhost:3000"

# Plaid — get from https://dashboard.plaid.com (Team Settings -> Keys)
PLAID_CLIENT_ID="your-plaid-client-id"
PLAID_SECRET="your-plaid-sandbox-secret"
# One of: sandbox | production
PLAID_ENV="sandbox"
# 32-byte hex key for encrypting Plaid access tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLAID_TOKEN_ENCRYPTION_KEY="your-64-char-hex-key"

# 32-byte hex key for encrypting TOTP MFA secrets at rest. Generate same way as above.
MFA_ENCRYPTION_KEY="your-64-char-hex-key"
