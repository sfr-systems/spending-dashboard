generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  firstName           String?
  lastName            String?
  passwordHash        String?
  avatarDataUrl       String?
  mfaSecretCiphertext String?
  mfaEnabledAt        DateTime?
  files               UploadedFile[]
  transactions        Transaction[]
  sourceNameOverrides SourceNameOverride[]
  preferences         UserPreference?
  plaidItems          PlaidItem[]
  mfaBackupCodes      MfaBackupCode[]
  smartCategories     SmartCategory[]
  transactionRules    TransactionRule[]
  loans               Loan[]
  loanPayments        LoanPayment[]
  trustedDevices      TrustedDevice[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model MfaBackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model SourceNameOverride {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalName String
  overrideName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, originalName])
  @@index([userId])
}

model UploadedFile {
  id                     String        @id @default(cuid())
  userId                 String
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalFilename       String
  storedFilename         String
  fileSize               Int
  mimeType               String
  uploadStatus           String        @default("uploaded")
  frozen                 Boolean       @default(false)
  rowCount               Int           @default(0)
  parsedTransactionCount Int           @default(0)
  parseError             String?
  transactions           Transaction[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

model Transaction {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source             String        @default("csv")
  fileId             String?
  file               UploadedFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)
  plaidAccountId     String?
  plaidAccount       PlaidAccount? @relation(fields: [plaidAccountId], references: [id], onDelete: Cascade)
  plaidTransactionId String?
  transactionDate    DateTime
  postedDate         DateTime?
  description        String
  cleanedDescription String        @default("")
  merchant           String?
  amount             Decimal
  category           String        @default("Uncategorized")
  derivedCategory    String        @default("Uncategorized")
  transactionType    String        @default("unknown")
  accountName        String?
  notes              String?
  excludedFromDashboard Boolean    @default(false)
  rawData            Json
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([userId, plaidTransactionId])
  @@index([userId, transactionDate])
  @@index([userId, category])
  @@index([userId, source])
  @@index([fileId])
  @@index([plaidAccountId])
}

model SmartCategory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

// User-defined rules that apply to transactions at read time.
// type = "recategorize": when matchField contains phrase, set Smart Category to targetCategory
// type = "exclude":     when matchField contains phrase, drop the transaction from views
model TransactionRule {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  matchField     String   @default("any")
  phrase         String
  targetCategory String?
  hidden         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model PlaidItem {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId           String         @unique
  institutionId         String?
  institutionName       String
  accessTokenCiphertext String
  cursor                String?
  status                String         @default("active")
  lastSyncedAt          DateTime?
  lastSyncError         String?
  accounts              PlaidAccount[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([userId])
}

model PlaidAccount {
  id             String        @id @default(cuid())
  itemId         String
  item           PlaidItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  plaidAccountId String        @unique
  name           String
  officialName   String?
  mask           String?
  type           String
  subtype        String?
  transactions   Transaction[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([itemId])
}

model Loan {
  id                 String        @id @default(cuid())
  userId             String        @unique
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  initialAmount      Decimal
  startDate          DateTime
  avgMonthlyCharge   Decimal
  payments           LoanPayment[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model LoanPayment {
  id          String   @id @default(cuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal
  paymentDate DateTime
  createdAt   DateTime @default(now())

  @@index([loanId])
  @@index([userId])
}

// Browsers the user chose to remember at sign-in; they skip the MFA code until
// expiresAt. The cookie carries a random token and only its SHA-256 is stored.
model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  label      String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}
